# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase secret. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional legacy key alternatives:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# WebRTC ICE configuration. STUN can be public; production needs a TURN service.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# TURN REST API shared secret for coturn-style time-limited credentials. Keep private.
TURN_REST_SECRET=
